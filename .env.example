# Home Assistant Configuration
HA_URL=http://your-ha-ip:8123
HA_TOKEN=your_long_lived_access_token_here

# Admin Configuration
ADMIN_PASSWORD=your_admin_password

# Development Paths (Windows - adjust for your OS)
WWW_SRC_DIR=public-dashboard\rootfs\var\www\src
WWW_PUBLIC_DIR=public-dashboard\rootfs\var\www\public
CONFIG_DIR=dev-config
