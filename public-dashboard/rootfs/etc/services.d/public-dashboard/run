#!/usr/bin/with-contenv bashio

bashio::log.info "Starting Public Dashboard backend..."

# Get configuration
ADMIN_PASSWORD=$(bashio::config 'admin_password')
LOG_LEVEL=$(bashio::config 'log_level')

# Debug token availability
bashio::log.info "SUPERVISOR_TOKEN available: $([ -n "$SUPERVISOR_TOKEN" ] && echo 'YES' || echo 'NO')"

# Export environment variables for Home Assistant integration
export ADMIN_PASSWORD
export LOG_LEVEL
export HA_URL="http://supervisor/core"
export HA_TOKEN="${SUPERVISOR_TOKEN}"

# Change to app directory
cd /app

# Start the application
exec python3 addon_main.py
